  stat3Value       String?  @default("24/7")
  stat3Label       String?  @default("RFQ Fast Response")
  bgImageUrl       String?  @db.Text
  overlayImageUrl  String?  @db.Text
  updatedAt        DateTime @updatedAt

  @@map("trading_services_hero_settings")
}

model TradingServiceDetailSetting {
  id                      Int             @id @default(autoincrement())
  tradingServiceId        Int?            @unique
  tradingService          TradingService? @relation(fields: [tradingServiceId], references: [id], onDelete: Cascade)

  heroKicker              String?         @default("INDUSTRIAL MATERIAL SUPPLY ☰")
  heroSubtitle            String?         @default("High-Grade Certified Supply for Saudi Mega Projects")
  overviewKicker          String?         @default("DIVISION OVERVIEW & STRATEGIC VALUE")
  overviewTitle           String?         @default("Uncompromising Quality in")
