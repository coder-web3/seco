model GalleryHeroSetting {
  id               Int      @id @default(autoincrement())
  kicker           String?  @default("MEDIA & VISUAL GALLERY")
  titleLine1       String?  @default("Engineering Excellence &")
  titleGreen       String?  @default("Project Showcase")
  subtitle         String?  @db.Text
  badge1Text       String?  @default("High-Resolution Project Photography")
  badge2Text       String?  @default("Aramco & SABIC Site Inspection Verification")
  badge3Text       String?  @default("100% Certified Operational Standards")
  bgImageUrl       String?  @db.Text
  updatedAt        DateTime @updatedAt

  @@map("gallery_hero_settings")
}

model ProjectsHeroSetting {
  id               Int      @id @default(autoincrement())
  kicker           String?  @default("OUR PORTFOLIO")
  titleLine1       String?  @default("Delivered Landmark")
  titleLine2       String?  @default("Industrial & Civil")
  titleGreen       String?  @default("Projects")
  subtitle         String?  @db.Text
  badge1Text       String?  @default("Safety Excellence")
  badge2Text       String?  @default("Aramco Certified")
  badge3Text       String?  @default("Kingdom Logistics")
  stat1Value       String?  @default("150+")
  stat1Label       String?  @default("Projects Delivered")
