datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String
  name         String
  role         String     @default("admin")
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  blogPosts    BlogPost[]

  @@map("admin_users")
}

model SiteSetting {
  id           Int      @id @default(autoincrement())
  siteName     String   @default("SECO LINE")
  siteTagline  String?
  contactEmail String?
  contactPhone String?
  address      String?
  workingHours String?
  socialLinks  String?  @db.Text
  logoUrl      String?
  faviconUrl   String?
  footerImageUrl String?
  footerText   String?
  updatedAt    DateTime @updatedAt

  @@map("site_settings")
}

model SeoSetting {
  id              Int      @id @default(autoincrement())
  pageKey         String   @unique
  metaTitle       String
  metaDescription String?  @db.Text
  metaKeywords    String?
  ogImage         String?
  canonicalUrl    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("seo_settings")
}

model Homepage {
  id                      Int      @id @default(autoincrement())
  heroBadge               String?
  heroTitle               String
  heroTitleLine2Green     String?
  heroSubtitle            String?  @db.Text
  heroCtaText             String?
  heroCtaLink             String?
  heroSecondaryCtaText    String?
  heroSecondaryCtaLink    String?
  heroImageUrl            String?  @db.Text
  personImageUrl          String?  @db.Text
  personHoverImageUrl     String?  @db.Text

  aboutKicker             String?
  aboutSnippetTitle       String?
  aboutTitleLine2Green    String?
  aboutSnippetContent     String?  @db.Text
  aboutSnippetImage       String?  @db.Text
  aboutSnippetLink        String?
  aboutCtaText            String?

  servicesKicker          String?
  servicesTitleLine1      String?
  servicesTitleLine2Green String?
  servicesDescription     String?  @db.Text
  servicesImageUrl        String?  @db.Text

  processKicker           String?
  processTitleLine1       String?
  processTitleLine2Green  String?
  processDescription      String?  @db.Text
  processConsultationLink String?
  processStepsJson        String?  @db.Text
  processImageUrl         String?  @db.Text

  projectsKicker          String?
  projectsTitleLine1      String?
  projectsTitleLine2Green String?
  projectsDescription     String?  @db.Text
  projectsImageUrl        String?  @db.Text

  featuresTitle           String?
  featuresSubtitle        String?  @db.LongText
  ctaTitle                String?  @db.Text
  ctaSubtitle             String?  @db.Text
  ctaButtonText           String?
  ctaButtonLink           String?
  updatedAt               DateTime @updatedAt

  @@map("homepage")
}

model HomepageStat {
  id        Int      @id @default(autoincrement())
  label     String
  value     String
  prefix    String?
  suffix    String?
  icon      String?
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("homepage_stats")
}

model AboutPage {
  id                 Int      @id @default(autoincrement())
  heading            String
  subheading         String?  @db.Text
  story              String?  @db.LongText
  mission            String?  @db.Text
  vision             String?  @db.Text
  values             String?  @db.LongText
  imageUrl           String?
  secondaryImageUrl  String?
  experienceYears    String?
  statsJson          String?  @db.Text

  // Section 1: Hero
  heroKicker          String?
  heroTitleLine1      String?
  heroTitleLine2Green String?
  heroSubtitle        String?  @db.Text
  heroBgImageUrl      String?
  heroVideoUrl        String?
  heroBadge1Value     String?
  heroBadge1Label     String?
  heroBadge2Value     String?
  heroBadge2Label     String?
  heroBadge3Value     String?
  heroBadge3Label     String?

  // Section 2: Vision, Mission & Values
  vmvKicker           String?
  vmvTitleLine1       String?
  vmvTitleLine2Green  String?
  vmvDescription      String?  @db.Text
  vmvSkylineImageUrl  String?
  vmvBadgeText        String?
  vmvVisionTitle      String?
  vmvVisionDesc       String?  @db.Text
  vmvMissionTitle     String?
  vmvMissionDesc      String?  @db.Text
  vmvValuesJson       String?  @db.LongText

  // Section 3: Our Strengths
  strengthsKicker          String?
  strengthsTitleLine1      String?
  strengthsTitleLine2Green String?
  strengthsDescription     String?  @db.Text
  strengthsTagline         String?
  strengthsImageUrl        String?
  strengthsBadgeText       String?
  strengthsJson            String?  @db.LongText

  // Section 4: Partner CTA Banner
  ctaKicker           String?
  ctaTitleLine1       String?
  ctaTitleLine2Green  String?
  ctaButtonText       String?
  ctaButtonLink       String?
  ctaValue1           String?
  ctaValue2           String?
  ctaValue3           String?
  ctaImageUrl         String?
  ctaOverlayText      String?

  updatedAt          DateTime @updatedAt

  @@map("about_page")
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  excerpt     String?  @db.Text
  content     String?  @db.LongText
  icon        String?
  imageUrl    String?
  features    String?  @db.Text
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  detailSetting ServiceDetailSetting?

  @@map("services")
}

model Project {
  id          Int            @id @default(autoincrement())
  title       String
  slug        String         @unique
  client      String?
  category    String?
  excerpt     String?        @db.Text
  content     String?        @db.LongText
  coverImage  String?
  completedAt DateTime?
  projectUrl  String?
  isFeatured  Boolean        @default(false)
  isPublished Boolean        @default(true)
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  images      ProjectImage[]

  @@map("projects")
}

model ProjectImage {
  id        Int      @id @default(autoincrement())
  projectId Int
  mediaUrl  String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_images")
}

model GalleryCategory {
  id        Int           @id @default(autoincrement())
  name      String
  slug      String        @unique
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  items     GalleryItem[]

  @@map("gallery_categories")
}

model GalleryItem {
  id          Int              @id @default(autoincrement())
  title       String
  mediaUrl    String
  categoryId  Int?
  description String?          @db.Text
  sortOrder   Int              @default(0)
  isPublished Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  category    GalleryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@map("gallery")
}

model Testimonial {
  id             Int      @id @default(autoincrement())
  authorName     String
  authorRole     String?
  company        String?
  content        String   @db.Text
  rating         Int      @default(5)
  avatarUrl      String?
  companyLogoUrl String?
  sortOrder      Int      @default(0)
  isPublished    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("testimonials")
}

model BlogCategory {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?    @db.Text
  createdAt   DateTime   @default(now())
  posts       BlogPost[]

  @@map("blog_categories")
}

model BlogTag {
  id        Int           @id @default(autoincrement())
  name      String
  slug      String        @unique
  createdAt DateTime      @default(now())
  posts     BlogPostTag[]

  @@map("blog_tags")
}

model BlogPost {
  id          Int           @id @default(autoincrement())
  title       String
  slug        String        @unique
  excerpt     String?       @db.Text
  content     String        @db.LongText
  coverImage  String?
  authorId    Int?
  categoryId  Int?
  isPublished Boolean       @default(false)
  publishedAt DateTime?
  views       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  author      AdminUser?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category    BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        BlogPostTag[]

  @@index([authorId])
  @@index([categoryId])
  @@index([slug])
  @@index([isPublished])
  @@map("blog_posts")
}

model BlogPostTag {
  id     Int      @id @default(autoincrement())
  postId Int
  tagId  Int
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@index([postId])
  @@index([tagId])
  @@map("blog_post_tags")
}

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
  @@map("contact_submissions")
}

model MediaFile {
  id           Int      @id @default(autoincrement())
  originalName String
  fileName     String   @unique
  filePath     String
  fileUrl      String
  mimeType     String
  fileSize     Int
  altText      String?
  createdAt    DateTime @default(now())

  @@index([mimeType])
  @@index([createdAt])
  @@map("media_files")
}

model ServicesHeroSetting {
  id               Int      @id @default(autoincrement())
  kicker           String?  @default("OUR SERVICES")
  titleLine1       String?  @default("Integrated Services for a")
  titleLine2       String?  @default("Stronger")
  titleGreen       String?  @default("Tomorrow")
  subtitle         String?  @db.Text
  badge1Text       String?  @default("Reliable Execution")
  badge2Text       String?  @default("Experienced Team")
  badge3Text       String?  @default("Sustainable Results")
  stat1Value       String?  @default("10+")
  stat1Label       String?  @default("Service Capabilities")
  stat2Value       String?  @default("25+")
  stat2Label       String?  @default("Years of Industry Support")
  stat3Value       String?  @default("100+")
  stat3Label       String?  @default("Projects Delivered")
  bgImageUrl       String?  @db.Text
  overlayImageUrl  String?  @db.Text
  updatedAt        DateTime @updatedAt

  @@map("services_hero_settings")
}

model ContactPageSetting {
  id                     Int      @id @default(autoincrement())
  heroKicker             String?  @default("CONTACT SECO LINE")
  heroTitleLine1         String?  @default("Let's Build Something")
  heroTitleLine2Green    String?  @default("Stronger Together.")
  heroSubtitle           String?  @db.Text
  heroBgImageUrl         String?  @db.Text
  heroOverlayImageUrl    String?  @db.Text
  
  enquiryKicker          String?  @default("GET IN TOUCH")
  enquiryTitleLine1      String?  @default("Start a Conversation About Your")
  enquiryTitleLine2Green String?  @default("Next Project.")
  enquiryDescription    String?  @db.Text
  
  generalEmail           String?  @default("info@secoline.com.sa")
  callPhone              String?  @default("+966 12 345 6789")
  headOfficeAddress      String?  @db.Text
  workingArea            String?  @default("Serving projects across Saudi Arabia")
  
  mapKicker              String?  @default("LOCATION & HEADQUARTERS")
  mapTitleLine1          String?  @default("Visit Our Headquarters in")
  mapTitleLine2Green     String?  @default("Riyadh, Saudi Arabia.")
  mapEmbedUrl            String?  @db.Text
  directMapsUrl          String?  @db.Text

  updatedAt              DateTime @updatedAt

  @@map("contact_page_settings")
}

model ServiceDetailSetting {
  id                      Int      @id @default(autoincrement())
  serviceId               Int?     @unique
  service                 Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  // 1. Hero Section
  heroKicker              String?  @default("OUR SERVICE ☰")
  heroSubtitle            String?  @default("Strong Foundations. A Sustainable Tomorrow.")
  heroStat1Value          String?  @default("20+")
  heroStat1Label          String?  @default("Years of Experience")
  heroStat2Value          String?  @default("200+")
  heroStat2Label          String?  @default("Projects Delivered")
  heroStat3Value          String?  @default("100%")
  heroStat3Label          String?  @default("Commitment to Safety")
  heroTagline             String?  @default("BUILDING A STRONGER TOMORROW")

  // 2. Overview Section
  overviewKicker          String?  @default("OUR SERVICES")
  overviewTitle           String?  @default("Building What")
  overviewTitleGreen      String?  @default("Matters Most")
  overviewDescription     String?  @db.Text
  feature1Title           String?  @default("Safety First")
  feature1Desc            String?  @default("A secure work environment for a better tomorrow.")
  feature2Title           String?  @default("Experienced Teams")
  feature2Desc            String?  @default("Skilled professionals delivering proven results.")
  feature3Title           String?  @default("Quality & Precision")
  feature3Desc            String?  @default("Built to last with attention to every detail.")
  pdfDownloadUrl          String?  @default("/SECO_LINE_PROFILE.pdf")

  // 3. Capabilities Section
  capabilitiesKicker      String?  @default("KEY CAPABILITIES")
  capabilitiesTitle1      String?  @default("Comprehensive Civil &")
  capabilitiesTitle2Green String?  @default("Construction Solutions")
  capabilitiesSubtitle    String?  @db.Text
  capabilitiesJson        String?  @db.LongText

  // 4. Execution Process Section
  processKicker           String?  @default("EXECUTION METHODOLOGY")
  processTitle1           String?  @default("Our Structured")
  processTitle2Green      String?  @default("4-Step Execution Process")
  processSubtitle        String?  @db.Text
  processStepsJson        String?  @db.LongText

  // 5. CTA Section
  ctaKicker               String?  @default("START A CONVERSATION")
  ctaTitle1               String?  @default("Ready to Execute")
  ctaTitle2Green          String?  @default("Your Next Project?")
  ctaDescription          String?  @db.Text
  ctaButtonText           String?  @default("Get a Free Proposal")
  ctaPhone                String?  @default("+966 12 345 6789")
  ctaBadge1               String?  @default("Rapid 24h Response")
  ctaBadge2               String?  @default("ISO & Aramco Standards")
  ctaBadge3               String?  @default("Nationwide Saudi Execution")

  updatedAt               DateTime @updatedAt

  @@map("service_detail_settings")
}

model TradingService {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  title         String
  shortDesc     String?  @db.Text
  fullDesc      String?  @db.LongText
  iconName      String?  @default("Layers")
  badge         String?
  imageUrl      String?  @db.Text
  heroBgUrl     String?  @db.Text
  tags          String?  @db.LongText
  features      String?  @db.LongText
  itemsSupplied String?  @db.LongText
  standards     String?  @db.LongText
  industriesJson String? @db.LongText
  whySecoJson   String?  @db.LongText
  processJson   String?  @db.LongText
  
  overviewKicker String?  @default("DIVISION OVERVIEW & STRATEGIC VALUE")
  overviewTitle  String?
  overviewSubtitle String? @db.Text
  overviewDesc2  String?  @db.Text
  overviewFeaturesJson String? @db.LongText
  pdfUrl         String?  @default("/SECO_LINE_PROFILE.pdf")
  
  categoriesKicker String? @default("PRODUCT / SERVICE CATEGORIES")
  categoriesTitle  String? @default("Main Supply Classifications")
  categoriesSubtitle String? @db.Text

  sortOrder     Int      @default(0)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  detailSetting TradingServiceDetailSetting?

  @@map("trading_services")
}

